# ─────────────────────────────────────────────────────────────────────────────
# Production environment variables (used by docker-compose.prod.yml on Dokploy).
#
# In Dokploy you paste these in the "Environment" tab of your Compose project.
# You only fill these in — DATABASE_URL, CORS_ORIGIN and NEXT_PUBLIC_API_URL are
# derived automatically from the values below, so do NOT add them by hand.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Domains ───
# The two subdomains your app will live on. Create DNS "A" records for both,
# pointing to your VPS IP, BEFORE deploying (so HTTPS certificates can be issued).
WEB_DOMAIN=app.tudominio.com
API_DOMAIN=api.tudominio.com

# ─── Database ───
# Use a long, random password. The database is private (not exposed publicly).
POSTGRES_DB=crm_academy
POSTGRES_USER=crm
POSTGRES_PASSWORD=cambia-esto-por-una-contrasena-larga

# ─── Authentication (login + roles) ───
# REQUIRED. Long random string used to sign session tokens — the API won't start
# without it. Generate one with:  openssl rand -hex 32
JWT_SECRET=
# First admin account, created automatically on the first deploy. Use a strong
# password; you can create more users (and change this one) from the Users
# screen once you log in.
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=cambia-esto-por-una-contrasena-fuerte
# Optional: session length in seconds (default 86400 = 1 day).
# JWT_EXPIRES_IN_SECONDS=86400

# ─────────────────────────────────────────────────────────────────────────────
# Everything below is OPTIONAL. The AI model and the WhatsApp connection are
# configured PER AGENT from the app UI (Agentes → tu agente → Configuración).
# Leave these empty unless you want a global fallback for all agents.
# ─────────────────────────────────────────────────────────────────────────────

# AI model (OpenRouter) — optional global fallback
OPENROUTER_API_KEY=
AGENT_MODEL=openai/gpt-4o-mini

# WhatsApp (YCloud) — optional global fallback
YCLOUD_API_KEY=
YCLOUD_WEBHOOK_SECRET=
YCLOUD_WHATSAPP_NUMBER=
