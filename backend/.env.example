# ─── Required ───
DATABASE_URL=postgresql://crm:crm@localhost:5433/crm_academy
PORT=3001

# ─── Authentication (login + roles) ───
# Secret used to sign session JWTs. REQUIRED in production (the app refuses to
# start with NODE_ENV=production unless this is set to a long random string).
# Generate one, e.g.:  openssl rand -hex 32
JWT_SECRET=
# Session length in seconds (default 86400 = 1 day).
JWT_EXPIRES_IN_SECONDS=86400
# Send the auth cookie only over HTTPS. Set to 'true' in production (behind
# HTTPS); leave 'false' for local http://localhost development.
COOKIE_SECURE=false
# Initial admin, created automatically on the FIRST run against an empty users
# table. Change the password immediately (here before first run, or later from
# the Users screen). If ADMIN_PASSWORD is unset, a default "Admin1234!" is used
# and a warning is logged.
ADMIN_EMAIL=admin@crmacademy.local
ADMIN_PASSWORD=
# Frontend origin(s) allowed by CORS (comma-separated). Required in production,
# e.g. CORS_ORIGIN=https://app.tudominio.com . Defaults to localhost in dev.
# CORS_ORIGIN=

# ─── Optional ───
# These are now configured PER AGENT from the app UI (Agentes → tu agente →
# Configuración). The env vars below are only used as a fallback when an agent
# leaves them empty — you can leave them blank.

# AI model (OpenRouter) — fallback only; normally set in the UI.
OPENROUTER_API_KEY=
AGENT_MODEL=openai/gpt-4o-mini

# WhatsApp (YCloud) — fallback only; normally set in the UI.
YCLOUD_API_KEY=
YCLOUD_WEBHOOK_SECRET=
YCLOUD_WHATSAPP_NUMBER=

# Demo data — on FIRST run against an empty database the app loads sample
# contacts, appointments and conversations so it isn't an empty shell. Set to
# 'false' to disable (recommended for a real production deployment).
SEED_DEMO_DATA=true

# ─── Stripe Payments (Optional - also configurable in UI) ───
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Observability (optional) ───
# Logs work out of the box with zero config: human-readable in development,
# structured JSON (one line per entry, with level/context/requestId) in
# production so a log viewer can parse them. Override only if you need to.
# Verbosity floor: error | warn | log | debug | verbose (default: log in prod,
# debug in dev). 'info' is accepted as an alias for 'log'.
# LOG_LEVEL=
# Force the output format: json | pretty (default: json in prod, pretty in dev).
# LOG_FORMAT=
